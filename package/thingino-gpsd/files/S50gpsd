#!/bin/sh

# shellcheck source=/dev/null
. /etc/init.d/lib-log

start() {
	log -c 15 "Starting gpsd"
	src=$(gps-select start)
	log -c 240 -e "- source: ${src:-none, waiting for modem or MiFi}"
}

stop() {
	log -c 15 "Stopping gpsd"
	gps-select stop
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		sleep 1
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
