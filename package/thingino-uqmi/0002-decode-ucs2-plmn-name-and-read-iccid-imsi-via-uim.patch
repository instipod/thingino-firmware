 	__uqmi_command(uim_power_off, uim-power-off, no, QMI_SERVICE_UIM), \
 	__uqmi_command(uim_power_on, uim-power-on, no, QMI_SERVICE_UIM), \
 	__uqmi_command(uim_channel_id, uim-channel-id, required, CMD_TYPE_OPTION), \
@@ -36,6 +38,9 @@
