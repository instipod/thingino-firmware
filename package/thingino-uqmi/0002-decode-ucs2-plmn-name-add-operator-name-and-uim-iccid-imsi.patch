+static int
+utf8_put(char *out, unsigned int cp)
+{
+	if (cp < 0x80) {
+		out[0] = cp;
+		return 1;
+	}
+	if (cp < 0x800) {
+		out[0] = 0xc0 | (cp >> 6);
+		out[1] = 0x80 | (cp & 0x3f);
+		return 2;
+	}
+	out[0] = 0xe0 | (cp >> 12);
+	out[1] = 0x80 | ((cp >> 6) & 0x3f);
+	out[2] = 0x80 | (cp & 0x3f);
+	return 3;
+}
+
+#define NAS_NAME_MAX (3 * 256 + 1)
+
+/* UCS-2 to UTF-8; byte order is guessed from where the NUL bytes sit. */
+static void
+nas_ucs2_to_utf8(const uint8_t *d, unsigned int n, char *out)
+{
+	unsigned int i, ofs = 0, even = 0, odd = 0;
+
+	for (i = 0; i < n; i++) {
+		if (d[i])
+			continue;
+		if (i & 1)
+			odd++;
+		else
+			even++;
+	}
+
+	for (i = 0; i + 1 < n && ofs + 3 < NAS_NAME_MAX; i += 2) {
+		unsigned int cp = even > odd ? (d[i] << 8) | d[i + 1] : d[i] | (d[i + 1] << 8);
+
+		if (!cp)
+			break;
+		if (cp >= 0xd800 && cp <= 0xdfff)
+			cp = '?';
+		ofs += utf8_put(out + ofs, cp);
+	}
+	out[ofs] = 0;
+}
+
+/* Packed GSM 7-bit default alphabet; non-ASCII characters become '?'. */
+static void
+nas_gsm7_to_utf8(const uint8_t *d, unsigned int n, unsigned int spare, char *out)
+{
+	unsigned int i, septets, ofs = 0;
+
+	if (spare > 7)
+		spare = 0;
+	septets = (n * 8 - (n ? spare : 0)) / 7;
+
+	for (i = 0; i < septets && ofs + 1 < NAS_NAME_MAX; i++) {
+		unsigned int bit = i * 7, byte = bit / 8, shift = bit % 8;
+		unsigned int c = d[byte] >> shift;
+
+		if (shift > 1 && byte + 1 < n)
+			c |= d[byte + 1] << (8 - shift);
+		c &= 0x7f;
+
+		if (c == 0x00)
+			c = '@';
+		else if (c == 0x02)
+			c = '$';
+		else if (c == 0x11)
+			c = '_';
+		else if (c == 0x1b)
+			continue;
+		else if (c < 0x20 || c == 0x24 || c == 0x40 ||
+			 (c >= 0x5b && c <= 0x60) || c >= 0x7b)
+			c = '?';
+		out[ofs++] = c;
+	}
+	while (ofs && out[ofs - 1] == '\r')
+		ofs--;
+	out[ofs] = 0;
+}
+
+static void
+nas_add_plmn_name(const char *key, uint8_t encoding, unsigned int spare,
+		  const uint8_t *d, unsigned int n)
+{
+	static char out[NAS_NAME_MAX];
+
+	if (!n)
+		return;
+	if (encoding == 1)
+		nas_ucs2_to_utf8(d, n, out);
+	else
+		nas_gsm7_to_utf8(d, n, spare, out);
+	if (out[0])
+		blobmsg_add_string(&status, key, out);
+}
+
+/*
+ * The current PLMN description carries no encoding indicator and some
+ * modems (e.g. Sierra Wireless) send it as UCS-2, which the generated
+ * parser truncates at the first NUL byte. Re-read the raw TLV and
+ * convert UCS-2 to UTF-8 when it contains NUL bytes.
+ */
+static const char *
+nas_plmn_description(struct qmi_msg *msg, const char *fallback)
+{
+	static char out[NAS_NAME_MAX];
+	unsigned int buflen = le16_to_cpu(msg->svc.tlv_len);
+	void *buf = msg->svc.tlv;
+	struct tlv *tlv;
+
+	while ((tlv = tlv_get_next(&buf, &buflen)) != NULL) {
+		unsigned int len = tlv_data_len(tlv);
+		unsigned int n;
+		uint8_t *d = tlv->data;
+
+		if (tlv->type != 0x12 || len < 5)
+			continue;
+
+		n = d[4];
+		d += 5;
+		if (n > len - 5)
+			n = len - 5;
+
+		if (n < 2 || !memchr(d, 0, n))
+			return fallback;
+
+		nas_ucs2_to_utf8(d, n, out);
+		return out;
+	}
+
+	return fallback;
+}
+
+static void
+cmd_nas_get_operator_name_cb(struct qmi_dev *qmi, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct qmi_nas_get_operator_name_response res;
+	char spn[NAS_NAME_MAX];
+	unsigned int i, n = 0;
+	void *c, *a;
+
+	qmi_parse_nas_get_operator_name_response(msg, &res);
+
+	c = blobmsg_open_table(&status, NULL);
+
+	if (res.set.service_provider_name && res.data.service_provider_name.name) {
+		const char *s = res.data.service_provider_name.name;
+
+		for (i = 0; s[i] && n + 1 < sizeof(spn); i++) {
+			if ((uint8_t)s[i] >= 0x20 && (uint8_t)s[i] < 0x7f)
+				spn[n++] = s[i];
+		}
+		spn[n] = 0;
+		if (n)
+			blobmsg_add_string(&status, "service_provider_name", spn);
+	}
+
+	if (res.set.nitz_information) {
+		nas_add_plmn_name("nitz_long_name",
+				  res.data.nitz_information.name_encoding,
+				  res.data.nitz_information.long_name_spare_bits,
+				  res.data.nitz_information.long_name,
+				  res.data.nitz_information.long_name_n);
+		nas_add_plmn_name("nitz_short_name",
+				  res.data.nitz_information.name_encoding,
+				  res.data.nitz_information.short_name_spare_bits,
+				  res.data.nitz_information.short_name,
+				  res.data.nitz_information.short_name_n);
+	}
+
+	if (res.data.operator_string_name && res.data.operator_string_name[0])
+		blobmsg_add_string(&status, "operator_string_name", res.data.operator_string_name);
+
+	if (res.data.operator_plmn_name_n) {
+		a = blobmsg_open_array(&status, "operator_plmn_names");
+		for (i = 0; i < res.data.operator_plmn_name_n; i++) {
+			void *t = blobmsg_open_table(&status, NULL);
+
+			nas_add_plmn_name("long_name",
+					  res.data.operator_plmn_name[i].name_encoding,
+					  res.data.operator_plmn_name[i].long_name_spare_bits,
+					  res.data.operator_plmn_name[i].long_name,
+					  res.data.operator_plmn_name[i].long_name_n);
+			nas_add_plmn_name("short_name",
+					  res.data.operator_plmn_name[i].name_encoding,
+					  res.data.operator_plmn_name[i].short_name_spare_bits,
+					  res.data.operator_plmn_name[i].short_name,
+					  res.data.operator_plmn_name[i].short_name_n);
+			blobmsg_close_table(&status, t);
+		}
+		blobmsg_close_array(&status, a);
+	}
+
+	blobmsg_close_table(&status, c);
+}
+
+static enum qmi_cmd_result
+cmd_nas_get_operator_name_prepare(struct qmi_dev *qmi, struct qmi_request *req, struct qmi_msg *msg, char *arg)
+{
+	qmi_set_nas_get_operator_name_request(msg);
+	return QMI_CMD_REQUEST;
+}
