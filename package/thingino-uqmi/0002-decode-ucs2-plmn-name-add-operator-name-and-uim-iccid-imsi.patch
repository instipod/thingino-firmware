  uqmi/commands-nas.h |   2 +
  uqmi/commands-uim.c | 111 +++++++++++++++++
  uqmi/commands-uim.h |   5 +
 4 files changed, 326 insertions(+), 1 deletion(-)

--- a/uqmi/commands-nas.c
+++ b/uqmi/commands-nas.c
@@ -1043,6 +1043,212 @@ cmd_nas_get_signal_info_prepare(struct qmi_dev *qmi, struct qmi_request *req, st
